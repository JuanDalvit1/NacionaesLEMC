# Supabase (frontend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Supabase (backend/sync - service role para escrita)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Google Sheets API (para planilhas públicas use API Key).
# Pode ficar em .env ou .env.local. Servidor e "npm run sync" devem rodar na raiz do projeto.
GOOGLE_SHEETS_API_KEY=sua-api-key

# Servidor (opcional)
PORT=3001
